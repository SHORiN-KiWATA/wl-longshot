#!/usr/bin/env bash
set -euo pipefail

APP_NAME="wl-longshot"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wl-longshot"
FILE_BACKEND="$CONFIG_DIR/backend"
FILE_ACTION="$CONFIG_DIR/action"
FILE_LIVE_PREVIEW="$CONFIG_DIR/live_preview"
FILE_GRIM_MODE="$CONFIG_DIR/grim_mode"
FILE_GRIM_DEDUP="$CONFIG_DIR/grim_dedup"
FILE_GRIM_FIXED_WIDTH="$CONFIG_DIR/grim_fixed_width"

mkdir -p "$CONFIG_DIR"

if [[ "${LANG:-}" == zh* || "${LANG:-}" == *ZH* ]]; then
    STR_CAPTURE="截取区域"
    STR_SETTINGS="设置"
    STR_QUIT="退出"
    STR_BACK="返回"
    STR_BACKEND="后端"
    STR_ACTION="动作"
    STR_LIVE_PREVIEW="实时预览"
    STR_GRIM_MODE="Grim 模式"
    STR_GRIM_DEDUP="Grim 去重"
    STR_GRIM_FIXED="Grim 定宽"
    STR_SAVE="仅保存"
    STR_OPEN="打开"
    STR_EDIT="编辑"
    STR_COPY="复制"
    STR_ON="开"
    STR_OFF="关"
else
    STR_CAPTURE="Capture Area"
    STR_SETTINGS="Settings"
    STR_QUIT="Quit"
    STR_BACK="Back"
    STR_BACKEND="Backend"
    STR_ACTION="Action"
    STR_LIVE_PREVIEW="Live Preview"
    STR_GRIM_MODE="Grim Mode"
    STR_GRIM_DEDUP="Grim Dedup"
    STR_GRIM_FIXED="Grim Fixed Width"
    STR_SAVE="Save Only"
    STR_OPEN="Open"
    STR_EDIT="Edit"
    STR_COPY="Copy"
    STR_ON="On"
    STR_OFF="Off"
fi

die() {
    printf '%s: %s\n' "$APP_NAME" "$*" >&2
    exit 1
}

script_dir() {
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P
}

find_rust_bin() {
    local dir
    dir="$(script_dir)"
    local candidates=(
        "${WL_LONGSHOT_BIN:-}"
        "$dir/wl-longshot-rs"
        "/usr/lib/wl-longshot/wl-longshot-rs"
        "$dir/../target/release/wl-longshot"
        "$dir/../target/debug/wl-longshot"
    )
    local candidate
    for candidate in "${candidates[@]}"; do
        if [[ -n "$candidate" && -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return
        fi
    done
    die "Rust backend not found. Set WL_LONGSHOT_BIN or install /usr/lib/wl-longshot/wl-longshot-rs."
}

RUST_BIN="$(find_rust_bin)"
MENU_CMD="${WL_LONGSHOT_MENU:-}"

get_conf() {
    local file="$1"
    local default="$2"
    if [[ -f "$file" ]]; then
        tr -d '\n' < "$file"
    else
        printf '%s\n' "$default"
    fi
}

set_conf() {
    local file="$1"
    local value="$2"
    printf '%s\n' "$value" > "$file"
}

find_menu() {
    if [[ -n "$MENU_CMD" ]]; then
        printf '%s\n' "$MENU_CMD"
        return
    fi
    local cmd
    for cmd in fuzzel rofi wofi; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf '%s\n' "$cmd"
            return
        fi
    done
}

show_menu() {
    local prompt="$1"
    local items="$2"
    local cmd
    cmd="$(find_menu || true)"
    if [[ -z "$cmd" ]]; then
        printf '%b\n' "$items" >&2
        printf '> ' >&2
        local line
        IFS= read -r line || return 1
        printf '%s\n' "$line"
        return
    fi
    case "$(basename -- "$cmd")" in
        fuzzel) printf '%b\n' "$items" | "$cmd" --dmenu --prompt "$prompt: " ;;
        rofi) printf '%b\n' "$items" | "$cmd" -dmenu -p "$prompt" ;;
        wofi) printf '%b\n' "$items" | "$cmd" --dmenu --prompt "$prompt" ;;
        *) printf '%b\n' "$items" | sh -c "$cmd" ;;
    esac
}

switch_label() {
    case "$1" in
        on) printf '%s\n' "$STR_ON" ;;
        *) printf '%s\n' "$STR_OFF" ;;
    esac
}

action_label() {
    case "$1" in
        open) printf '%s\n' "$STR_OPEN" ;;
        edit) printf '%s\n' "$STR_EDIT" ;;
        copy) printf '%s\n' "$STR_COPY" ;;
        *) printf '%s\n' "$STR_SAVE" ;;
    esac
}

capture_args() {
    local backend action live grim_mode grim_dedup grim_fixed
    backend="$(get_conf "$FILE_BACKEND" frame)"
    action="$(get_conf "$FILE_ACTION" save)"
    live="$(get_conf "$FILE_LIVE_PREVIEW" off)"
    grim_mode="$(get_conf "$FILE_GRIM_MODE" auto)"
    grim_dedup="$(get_conf "$FILE_GRIM_DEDUP" on)"
    grim_fixed="$(get_conf "$FILE_GRIM_FIXED_WIDTH" on)"

    printf '%s\0%s\0' --backend "$backend"
    [[ "$live" == on ]] && printf '%s\0' --preview
    case "$action" in
        open) printf '%s\0' --open ;;
        edit) printf '%s\0' --edit ;;
        copy) printf '%s\0' --copy ;;
    esac
    if [[ "$backend" == grim ]]; then
        printf '%s\0%s\0' --grim-mode "$grim_mode"
        [[ "$grim_dedup" == off ]] && printf '%s\0' --no-grim-dedup
        [[ "$grim_fixed" == off ]] && printf '%s\0' --no-grim-fixed-width
    fi
}

run_capture() {
    local -a args=()
    while IFS= read -r -d '' arg; do
        args+=("$arg")
    done < <(capture_args)
    exec "$RUST_BIN" "${args[@]}"
}

settings_menu() {
    while true; do
        local backend action live grim_mode grim_dedup grim_fixed choice items
        backend="$(get_conf "$FILE_BACKEND" frame)"
        action="$(get_conf "$FILE_ACTION" save)"
        live="$(get_conf "$FILE_LIVE_PREVIEW" off)"
        grim_mode="$(get_conf "$FILE_GRIM_MODE" auto)"
        grim_dedup="$(get_conf "$FILE_GRIM_DEDUP" on)"
        grim_fixed="$(get_conf "$FILE_GRIM_FIXED_WIDTH" on)"
        items="$STR_BACK\n$STR_BACKEND [$backend]\n$STR_ACTION [$(action_label "$action")]\n$STR_LIVE_PREVIEW [$(switch_label "$live")]"
        if [[ "$backend" == grim ]]; then
            items="$items\n$STR_GRIM_MODE [$grim_mode]\n$STR_GRIM_FIXED [$(switch_label "$grim_fixed")]\n$STR_GRIM_DEDUP [$(switch_label "$grim_dedup")]"
        fi
        choice="$(show_menu "$STR_SETTINGS" "$items" || true)"
        case "$choice" in
            "$STR_BACK"|"") return ;;
            "$STR_BACKEND"*)
                choice="$(show_menu "$STR_BACKEND" "$STR_BACK\nframe\ngrim" || true)"
                case "$choice" in frame|grim) set_conf "$FILE_BACKEND" "$choice" ;; esac
                ;;
            "$STR_ACTION"*)
                choice="$(show_menu "$STR_ACTION" "$STR_BACK\n$STR_SAVE\n$STR_OPEN\n$STR_EDIT\n$STR_COPY" || true)"
                case "$choice" in
                    "$STR_SAVE") set_conf "$FILE_ACTION" save ;;
                    "$STR_OPEN") set_conf "$FILE_ACTION" open ;;
                    "$STR_EDIT") set_conf "$FILE_ACTION" edit ;;
                    "$STR_COPY") set_conf "$FILE_ACTION" copy ;;
                esac
                ;;
            "$STR_LIVE_PREVIEW"*) [[ "$live" == on ]] && set_conf "$FILE_LIVE_PREVIEW" off || set_conf "$FILE_LIVE_PREVIEW" on ;;
            "$STR_GRIM_MODE"*) [[ "$grim_mode" == auto ]] && set_conf "$FILE_GRIM_MODE" manual || set_conf "$FILE_GRIM_MODE" auto ;;
            "$STR_GRIM_FIXED"*) [[ "$grim_fixed" == on ]] && set_conf "$FILE_GRIM_FIXED_WIDTH" off || set_conf "$FILE_GRIM_FIXED_WIDTH" on ;;
            "$STR_GRIM_DEDUP"*) [[ "$grim_dedup" == on ]] && set_conf "$FILE_GRIM_DEDUP" off || set_conf "$FILE_GRIM_DEDUP" on ;;
        esac
    done
}

main_menu() {
    while true; do
        local choice
        choice="$(show_menu "$APP_NAME" "$STR_CAPTURE\n$STR_SETTINGS\n$STR_QUIT" || true)"
        case "$choice" in
            "$STR_CAPTURE") run_capture ;;
            "$STR_SETTINGS") settings_menu ;;
            "$STR_QUIT"|"") exit 0 ;;
        esac
    done
}

mode="capture"
forward=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --menu-mode) mode="menu" ;;
        --settings) mode="settings" ;;
        -m|--menu)
            shift || die "missing argument for --menu"
            MENU_CMD="$1"
            ;;
        --wrapper-help)
            cat <<EOF
Usage: wl-longshot [Rust options]
       wl-longshot --menu-mode
       wl-longshot --settings

Wrapper options:
  --menu-mode        Open capture/settings menu.
  --settings         Open settings menu.
  -m, --menu CMD     Override menu command.
  --wrapper-help     Show wrapper help.

All other options are passed directly to the Rust wl-longshot binary.
EOF
            exit 0
            ;;
        *) forward+=("$1") ;;
    esac
    shift
done

case "$mode" in
    menu) main_menu ;;
    settings) settings_menu ;;
    capture)
        if [[ ${#forward[@]} -gt 0 ]]; then
            exec "$RUST_BIN" "${forward[@]}"
        fi
        run_capture
        ;;
esac
